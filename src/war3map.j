        return false
    endif
    if ( not ( IsPlayerInForce(Player(2), GetPlayersAll()) == false ) ) then
        return false
    endif
    if ( not ( IsPlayerInForce(Player(3), GetPlayersAll()) == false ) ) then
        return false
    endif
    return true
