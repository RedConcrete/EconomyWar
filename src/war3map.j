function Trig_Winners_Declared_Actions takes nothing returns nothing
    if ( Trig_Winners_Declared_Func002C() ) then
        call CustomVictoryBJ( Player(0), true, true )
    else
        call DoNothing(  )
    endif
    if ( Trig_Winners_Declared_Func003C() ) then
        call CustomVictoryBJ( Player(1), true, true )
    else
        call DoNothing(  )
    endif
    if ( Trig_Winners_Declared_Func004C() ) then
        call CustomVictoryBJ( Player(2), true, true )
    else
        call DoNothing(  )
    endif
    if ( Trig_Winners_Declared_Func005C() ) then
        call CustomVictoryBJ( Player(3), true, true )
    else
        call DoNothing(  )
    endif
